{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicontrolcenter:dpl:contract:v1:activation-inspection-report",
  "title": "ActivationInspectionReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inspection_id",
    "inspection_mode",
    "read_only",
    "started_at",
    "completed_at",
    "overall_status",
    "policy_version",
    "policy_digest",
    "route_manifest_version",
    "route_manifest_digest",
    "git",
    "runtime",
    "launchd",
    "process",
    "listener",
    "http",
    "checks",
    "blocking_reasons",
    "warnings",
    "sanitized_errors",
    "production_writes",
    "ubuntu_changes",
    "production_authorized",
    "report_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "dpl/v1"
    },
    "inspection_id": {
      "type": "string",
      "pattern": "^activation-inspection-[a-z0-9][a-z0-9-]{7,79}$"
    },
    "inspection_mode": {
      "const": "READ_ONLY"
    },
    "read_only": {
      "const": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_status": {
      "enum": [
        "READY_FOR_AUTHORIZATION_REVIEW",
        "BLOCKED",
        "ERROR"
      ]
    },
    "policy_version": {
      "const": "activation-inspection-policy/v1"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "route_manifest_version": {
      "const": "activation-route-manifest/v1"
    },
    "route_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "repository_path",
        "branch",
        "head",
        "clean",
        "remote_sync",
        "ahead",
        "behind",
        "evidence_digest"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "repository_path": {
          "type": "string",
          "pattern": "^/"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "clean": {
          "type": "boolean"
        },
        "remote_sync": {
          "type": "boolean"
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_runtime",
        "candidate_runtime",
        "pointer_status",
        "candidate_available",
        "metadata_status",
        "metadata_digest",
        "source_marker_status",
        "source_marker_commit",
        "python_status",
        "python_executable",
        "python_version",
        "repository_pythonpath_coupled",
        "evidence_digest"
      ],
      "properties": {
        "current_runtime": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "candidate_runtime": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "pointer_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "MISSING",
            "MALFORMED",
            "UNAVAILABLE"
          ]
        },
        "candidate_available": {
          "type": "boolean"
        },
        "metadata_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "MISSING",
            "MALFORMED",
            "UNAVAILABLE"
          ]
        },
        "metadata_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_marker_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "MISSING",
            "MALFORMED",
            "UNAVAILABLE"
          ]
        },
        "source_marker_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "python_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "MISSING",
            "MALFORMED",
            "UNAVAILABLE"
          ]
        },
        "python_executable": {
          "type": "string",
          "pattern": "^/"
        },
        "python_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_pythonpath_coupled": {
          "type": "boolean"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "launchd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "available",
        "running",
        "pid",
        "application_user",
        "allowed_operation",
        "evidence_digest"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^system/[A-Za-z0-9_.-]+$"
        },
        "available": {
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "application_user": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_operation": {
          "const": "print"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_count",
        "observed_count",
        "pid",
        "user",
        "root_process",
        "evidence_digest"
      ],
      "properties": {
        "expected_count": {
          "const": 1
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_process": {
          "type": "boolean"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "expected_count",
        "observed_count",
        "pid",
        "loopback_only",
        "pid_matches_service",
        "evidence_digest"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "expected_count": {
          "const": 1
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "loopback_only": {
          "type": "boolean"
        },
        "pid_matches_service": {
          "type": "boolean"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "results",
        "evidence_digest"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "probe_id",
              "method",
              "path",
              "expected_status",
              "actual_status",
              "result",
              "redirect_followed",
              "attempt_count",
              "body_length",
              "sanitized_error"
            ],
            "properties": {
              "probe_id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "GET",
                  "POST"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9/_\\-.]*$"
              },
              "expected_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "actual_status": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 100,
                "maximum": 599
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "ERROR"
                ]
              },
              "redirect_followed": {
                "const": false
              },
              "attempt_count": {
                "const": 1
              },
              "body_length": {
                "const": 0
              },
              "sanitized_error": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              }
            }
          }
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "expected",
          "actual",
          "result",
          "blocking",
          "evidence_reference",
          "timestamp"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_]{2,99}$"
          },
          "expected": {},
          "actual": {},
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "evidence_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "blocking_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "sanitized_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "component",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "production_writes": {
      "const": 0
    },
    "ubuntu_changes": {
      "const": 0
    },
    "production_authorized": {
      "const": false
    },
    "report_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "READY_FOR_AUTHORIZATION_REVIEW"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "blocking_reasons": {
            "maxItems": 0
          },
          "sanitized_errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "blocking_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "ERROR"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "sanitized_errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

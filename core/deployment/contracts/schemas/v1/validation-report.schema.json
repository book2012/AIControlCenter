{
  "$id": "urn:aicontrolcenter:dpl:contract:v1:validation-report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/ReadOnlyHeader"
    }
  ],
  "properties": {
    "issues": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/Identifier"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "package_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "read_only": {
      "const": true
    },
    "schema_version": {
      "const": "dpl/v1"
    },
    "valid": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "read_only",
    "package_digest",
    "valid",
    "issues"
  ],
  "title": "ValidationReport",
  "type": "object"
}

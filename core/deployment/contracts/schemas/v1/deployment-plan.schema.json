{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicontrolcenter:dpl:contract:v1:deployment-plan",
  "title": "DeploymentPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_digest", "package_digest", "target_identity", "target_profile", "read_only", "dry_run", "execution_authorized", "production_authorized", "actions", "dependency_edges", "prerequisites", "blocking_reasons", "risk_level", "approval_required", "evidence_digests", "warnings", "overall_status", "production_writes", "ubuntu_changes"],
  "properties": {
    "schema_version": {"const": "dpl/v1"},
    "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{32}$"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "package_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "target_identity": {"$ref": "common.schema.json#/$defs/Identifier"},
    "target_profile": {"$ref": "deployment-target-profile.schema.json"},
    "read_only": {"const": true},
    "dry_run": {"const": true},
    "execution_authorized": {"const": false},
    "production_authorized": {"const": false},
    "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "deployment-plan-action.schema.json"}},
    "dependency_edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_action_id", "to_action_id"],
        "properties": {
          "from_action_id": {"type": "string", "pattern": "^act-[0-9a-f]{24}$"},
          "to_action_id": {"type": "string", "pattern": "^act-[0-9a-f]{24}$"}
        }
      }
    },
    "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blocking_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "approval_required": {"type": "boolean"},
    "evidence_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_policy", "ingress_readiness", "mac_inventory"],
      "properties": {
        "dependency_policy": {"$ref": "common.schema.json#/$defs/Digest"},
        "ingress_readiness": {"$ref": "common.schema.json#/$defs/Digest"},
        "mac_inventory": {"$ref": "common.schema.json#/$defs/Digest"}
      }
    },
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "overall_status": {"enum": ["READY_FOR_APPROVAL", "BLOCKED", "NOT_READY", "INVALID", "INCOMPLETE"]},
    "production_writes": {"const": 0},
    "ubuntu_changes": {"const": 0}
  }
}

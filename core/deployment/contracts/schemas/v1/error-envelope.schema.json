{
  "$id": "urn:aicontrolcenter:dpl:contract:v1:error-envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/ReadOnlyHeader"
    }
  ],
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "path"
      ],
      "type": "object"
    },
    "read_only": {
      "const": true
    },
    "schema_version": {
      "const": "dpl/v1"
    }
  },
  "required": [
    "schema_version",
    "read_only",
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicontrolcenter:dpl:contract:v1:activation-route-manifest",
  "title": "ActivationRouteManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "read_only",
    "target",
    "probes",
    "production_writes",
    "ubuntu_changes",
    "production_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "dpl/v1"
    },
    "manifest_version": {
      "const": "activation-route-manifest/v1"
    },
    "read_only": {
      "const": true
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "const": 18100
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "method",
          "path",
          "expected_status",
          "body_length",
          "attempt_count",
          "automatic_retries",
          "follow_redirects",
          "send_credentials",
          "send_cookies",
          "send_authorization",
          "user_supplied_headers"
        ],
        "properties": {
          "probe_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_\\-.]*$"
          },
          "expected_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "body_length": {
            "const": 0
          },
          "attempt_count": {
            "const": 1
          },
          "automatic_retries": {
            "const": 0
          },
          "follow_redirects": {
            "const": false
          },
          "send_credentials": {
            "const": false
          },
          "send_cookies": {
            "const": false
          },
          "send_authorization": {
            "const": false
          },
          "user_supplied_headers": {
            "const": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "method": {
                  "const": "GET"
                }
              },
              "required": [
                "method"
              ]
            },
            "then": {
              "properties": {
                "expected_status": {
                  "const": 200
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "method": {
                  "const": "POST"
                }
              },
              "required": [
                "method"
              ]
            },
            "then": {
              "properties": {
                "path": {
                  "const": "/health"
                },
                "expected_status": {
                  "const": 405
                }
              }
            }
          }
        ]
      }
    },
    "production_writes": {
      "const": 0
    },
    "ubuntu_changes": {
      "const": 0
    },
    "production_authorized": {
      "const": false
    }
  }
}

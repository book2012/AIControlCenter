{
  "$id": "urn:aicontrolcenter:dpl:contract:v1:inventory-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/ReadOnlyHeader"
    }
  ],
  "properties": {
    "captured_at": {
      "$ref": "common.schema.json#/$defs/UtcDateTime"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "component_id": {
            "$ref": "common.schema.json#/$defs/Identifier"
          },
          "component_type": {
            "$ref": "common.schema.json#/$defs/Identifier"
          },
          "details": {
            "type": "object"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "$ref": "common.schema.json#/$defs/Identifier"
                },
                "message": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "$ref": "common.schema.json#/$defs/Identifier"
                },
                "reference": {
                  "$ref": "common.schema.json#/$defs/PackagePath"
                }
              },
              "required": [
                "kind",
                "reference"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "observed": {
            "type": "boolean"
          },
          "state": {
            "enum": [
              "present",
              "absent",
              "unknown",
              "degraded",
              "unavailable"
            ]
          }
        },
        "required": [
          "component_id",
          "component_type",
          "observed",
          "state",
          "details",
          "evidence",
          "errors"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "read_only": {
      "const": true
    },
    "schema_version": {
      "const": "dpl/v1"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/Target"
    }
  },
  "required": [
    "schema_version",
    "read_only",
    "captured_at",
    "target",
    "items"
  ],
  "title": "InventoryResult",
  "type": "object"
}

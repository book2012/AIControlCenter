{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicontrolcenter:dpl:contract:v1:executor-request",
  "title": "ExecutorRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "execution_authorization_id", "capability_id", "package_digest", "plan_digest", "target_identity", "target_owner", "environment", "operation_scope", "actor_identity", "nonce_reference", "request_timestamp", "production_authorized"],
  "properties": {
    "schema_version": {"const": "dpl/v1"},
    "request_id": {"type": "string", "pattern": "^exr-[0-9a-f]{32}$"},
    "execution_authorization_id": {"type": "string", "pattern": "^exa-[0-9a-f]{32}$"},
    "capability_id": {"type": "string", "pattern": "^exc-[0-9a-f]{32}$"},
    "package_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "target_identity": {"$ref": "common.schema.json#/$defs/Identifier"},
    "target_owner": {"const": "mac-control-plane"},
    "environment": {"enum": ["development", "test", "staging"]},
    "operation_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["VERIFY_SANDBOX_TARGET", "VALIDATE_DEPLOYMENT_PACKAGE", "VALIDATE_DEPLOYMENT_PLAN", "VALIDATE_AUTHORIZATION", "PREPARE_SANDBOX", "SIMULATE_EXECUTION", "COLLECT_EXECUTION_EVIDENCE"]}},
    "actor_identity": {"$ref": "common.schema.json#/$defs/Identifier"},
    "nonce_reference": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "request_timestamp": {"type": "string", "format": "date-time"},
    "production_authorized": {"const": false}
  }
}

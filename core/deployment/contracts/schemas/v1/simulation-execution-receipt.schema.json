{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicontrolcenter:dpl:contract:v1:simulation-execution-receipt",
  "title": "SimulationExecutionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "receipt_digest", "authorization_id", "approval_request_id", "approval_decision_id", "package_digest", "plan_digest", "target_identity", "environment", "action_scope", "actor_identity", "approver_identity", "nonce_digest", "execution_mode", "executor_type", "result_status", "simulated_actions", "input_evidence_digests", "started_timestamp", "completed_timestamp", "production_authorized", "production_writes", "ubuntu_changes", "network_accesses", "runtime_commands", "executor_invocations"],
  "properties": {
    "schema_version": {"const": "dpl/v1"},
    "receipt_id": {"type": "string", "pattern": "^sim-[0-9a-f]{32}$"},
    "receipt_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "authorization_id": {"type": "string", "pattern": "^exa-[0-9a-f]{32}$"},
    "approval_request_id": {"type": "string", "pattern": "^apr-[0-9a-f]{32}$"},
    "approval_decision_id": {"type": "string", "pattern": "^apd-[0-9a-f]{32}$"},
    "package_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "target_identity": {"$ref": "common.schema.json#/$defs/Identifier"},
    "environment": {"enum": ["development", "test", "staging", "sandbox"]},
    "action_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^act-[0-9a-f]{24}$"}},
    "actor_identity": {"$ref": "common.schema.json#/$defs/Identifier"},
    "approver_identity": {"$ref": "common.schema.json#/$defs/Identifier"},
    "nonce_digest": {"$ref": "common.schema.json#/$defs/Digest"},
    "execution_mode": {"const": "simulation"},
    "executor_type": {"const": "fake"},
    "result_status": {"const": "SIMULATED"},
    "simulated_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "action_type", "target", "dependency_ids", "status", "result_digest"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^act-[0-9a-f]{24}$"},
          "action_type": {"type": "string", "minLength": 1},
          "target": {"$ref": "common.schema.json#/$defs/Identifier"},
          "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^act-[0-9a-f]{24}$"}},
          "status": {"const": "SIMULATED"},
          "result_digest": {"$ref": "common.schema.json#/$defs/Digest"}
        }
      }
    },
    "input_evidence_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_policy", "ingress_readiness", "mac_inventory"],
      "properties": {
        "dependency_policy": {"$ref": "common.schema.json#/$defs/Digest"},
        "ingress_readiness": {"$ref": "common.schema.json#/$defs/Digest"},
        "mac_inventory": {"$ref": "common.schema.json#/$defs/Digest"}
      }
    },
    "started_timestamp": {"type": "string", "format": "date-time"},
    "completed_timestamp": {"type": "string", "format": "date-time"},
    "production_authorized": {"const": false},
    "production_writes": {"const": 0},
    "ubuntu_changes": {"const": 0},
    "network_accesses": {"const": 0},
    "runtime_commands": {"const": 0},
    "executor_invocations": {"const": 1}
  }
}

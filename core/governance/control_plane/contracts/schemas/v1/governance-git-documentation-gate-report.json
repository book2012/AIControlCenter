{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:aicontrolcenter:governance:v1:git-documentation-gate-report","title":"GovernanceGitDocumentationGateReport","type":"object","additionalProperties":false,"required":["schema_version","report_id","lifecycle_id","branch","commit","worktree_clean","upstream_relation","required_document_status","evidence_manifest_digest","decision","reason_codes","evaluated_at"],"properties":{"schema_version":{"const":"governance/v1"},"report_id":{"$ref":"#/$defs/text"},"lifecycle_id":{"$ref":"#/$defs/text"},"branch":{"$ref":"#/$defs/text"},"commit":{"$ref":"#/$defs/text"},"worktree_clean":{"type":"boolean"},"upstream_relation":{"enum":["SYNCED","AHEAD","BEHIND","DIVERGED","UNTRACKED"]},"required_document_status":{"enum":["COMPLETE","INCOMPLETE","NOT_APPLICABLE"]},"evidence_manifest_digest":{"$ref":"#/$defs/text"},"decision":{"enum":["PASS","FAIL"]},"reason_codes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/code"}},"evaluated_at":{"type":"string","format":"date-time"}},"$defs":{"text":{"type":"string","minLength":1},"code":{"type":"string","pattern":"^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"}}}

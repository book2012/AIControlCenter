{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:aicontrolcenter:governance:v1:failure-evidence","title":"GovernanceFailureEvidence","type":"object","additionalProperties":false,"required":["schema_version","failure_id","lifecycle_id","phase","failure_class","reason_codes","authorization_state","claim_consumed","actual_invocation_count","completed_count","uncertain_count","retry_prohibited","rollback_prohibited","manual_action_required","occurred_at"],"properties":{"schema_version":{"const":"governance/v1"},"failure_id":{"$ref":"#/$defs/text"},"lifecycle_id":{"$ref":"#/$defs/text"},"phase":{"enum":["PRECONDITION","AUTHORIZATION_CONSUMPTION","EXECUTION","POSTCONDITION","EVIDENCE_PERSISTENCE","CLOSEOUT"]},"failure_class":{"enum":["PRECONDITION_FAILED","AUTHORIZATION_CONSUMPTION_FAILED","EXECUTION_FAILED","EXECUTION_UNCERTAIN","POSTCONDITION_FAILED","EVIDENCE_PERSISTENCE_FAILED","CLOSEOUT_FAILED"]},"reason_codes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/code"}},"authorization_state":{"enum":["REQUESTED","AUTHORIZED","STALE","CONSUMED","REJECTED"]},"claim_consumed":{"type":"boolean"},"actual_invocation_count":{"type":"integer","minimum":0},"completed_count":{"type":"integer","minimum":0},"uncertain_count":{"type":"integer","minimum":0},"retry_prohibited":{"const":true},"rollback_prohibited":{"const":true},"manual_action_required":{"type":"boolean"},"occurred_at":{"type":"string","format":"date-time"}},"$defs":{"text":{"type":"string","minLength":1},"code":{"type":"string","pattern":"^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"}}}

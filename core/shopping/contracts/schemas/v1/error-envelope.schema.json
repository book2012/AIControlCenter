{
  "$id": "urn:aicontrolcenter:shopping:contract:v1:error-envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fail-closed Shopping error envelope.",
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "pattern": "^shopping\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$",
          "type": "string"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/CorrelationId"
        },
        "details": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "path"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "type": "array"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "correlation_id",
        "message"
      ],
      "type": "object"
    }
  },
  "required": [
    "error"
  ],
  "title": "Shopping Error Envelope",
  "type": "object"
}

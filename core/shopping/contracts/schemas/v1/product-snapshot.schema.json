{
  "$id": "urn:aicontrolcenter:shopping:contract:v1:product-snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical read-only product projection.",
  "properties": {
    "description": {
      "type": "string"
    },
    "image_urls": {
      "items": {
        "format": "uri",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "in_stock": {
      "type": "boolean"
    },
    "inventory_quantity": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "price": {
      "$ref": "common.schema.json#/$defs/Money"
    },
    "product_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "sku": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/UtcDateTime"
    },
    "url": {
      "anyOf": [
        {
          "format": "uri",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "in_stock",
    "inventory_quantity",
    "name",
    "price",
    "product_id",
    "updated_at"
  ],
  "title": "ProductSnapshot",
  "type": "object"
}

{
  "schema_version": "1.0",
  "definition_id": "shopping-secret-provisioning",
  "backend_definition_id": "shopping-secret-backend",
  "inspection_mode": "READ_ONLY",
  "governance_compatibility": "SEC-02_CONTROLLED_EXECUTION",
  "production_status": "NOT_DEPLOYED",
  "materialization_implemented": false,
  "value_free": true,
  "offline_recovery_intake_policy": {
    "base": "control-plane-home",
    "relative_path": ".config/aicontrolcenter/shopping-secrets/inbox/offline-recovery.txt",
    "required_owner": "control-plane-user",
    "maximum_mode": "0600",
    "external_to_repository": true,
    "no_clobber": true,
    "public_recipient_only": true
  },
  "actions": [
    {
      "action_id": "SHOPPING_SECRET_TOOL:SOPS_INSTALL_ENSURE",
      "planner_rule": "SOPS_PRESENT",
      "missing_reason_code": "SOPS_TOOL_MISSING"
    },
    {
      "action_id": "SHOPPING_SECRET_TOOL:AGE_INSTALL_ENSURE",
      "planner_rule": "AGE_TOOLING_PRESENT",
      "missing_reason_code": "AGE_TOOLING_MISSING"
    },
    {
      "action_id": "SHOPPING_SECRET_IDENTITY:CONTROL_PLANE_CREATE",
      "planner_rule": "CONTROL_PLANE_IDENTITY_PRESENT",
      "missing_reason_code": "CONTROL_PLANE_IDENTITY_MISSING"
    },
    {
      "action_id": "SHOPPING_SECRET_RECIPIENT:CONTROL_PLANE_REGISTER_VALIDATE",
      "planner_rule": "CONTROL_PLANE_RECIPIENT_VALID",
      "missing_reason_code": "CONTROL_PLANE_RECIPIENT_METADATA_MISSING_OR_INVALID"
    },
    {
      "action_id": "SHOPPING_SECRET_RECIPIENT:OFFLINE_RECOVERY_REGISTER_VALIDATE",
      "planner_rule": "OFFLINE_RECOVERY_RECIPIENT_VALID",
      "missing_reason_code": "OFFLINE_RECOVERY_RECIPIENT_METADATA_MISSING_OR_INVALID"
    },
    {
      "action_id": "SHOPPING_SECRET_RECIPIENT:OFFLINE_RECOVERY_INTAKE",
      "planner_rule": "OFFLINE_RECOVERY_INBOX_READY",
      "missing_reason_code": "OFFLINE_RECOVERY_PUBLIC_RECIPIENT_INTAKE_REQUIRED"
    }
  ]
}

{
  "schema_version": "1.0",
  "profile": "mac-standalone-production",
  "control_plane": {
    "host_role": "brain",
    "required": true,
    "ubuntu_dependency": false
  },
  "services": [
    {
      "service_id": "aicontrolcenter-api",
      "logical_id": "api",
      "runtime_health": true,
      "role": "control-plane",
      "owner": "aicontrolcenter",
      "required": true,
      "production_status": "PRODUCTION",
      "runtime": "python-immutable-venv",
      "supervisor": "system-launchdaemon",
      "lifecycle": "launchd",
      "launchd_label": "com.aicontrolcenter.api",
      "listen_host": "127.0.0.1",
      "port": 58081,
      "health_endpoint": "/health",
      "dashboard_endpoint": "/dashboard",
      "ubuntu_dependency": false,
      "state_policy": "control-plane-owned",
      "service_platform": {
        "immutable_runtime": {
          "runtime_root": "/Users/kyouhan/Library/Application Support/AIControlCenter/runtime"
        },
        "application_entrypoint": "ops.macos.runtime.application:app",
        "log_parent": {
          "path": "/var/log/aicontrolcenter",
          "type": "directory",
          "mode": 493,
          "owner": "root",
          "group": "wheel"
        },
        "logs": [
          {
            "path": "/var/log/aicontrolcenter/canonical-api.stdout.log",
            "type": "file",
            "mode": 416,
            "owner": "kyouhan",
            "group": "staff"
          },
          {
            "path": "/var/log/aicontrolcenter/canonical-api.stderr.log",
            "type": "file",
            "mode": 416,
            "owner": "kyouhan",
            "group": "staff"
          }
        ],
        "health_observation": "launchd",
        "lifecycle_capabilities": [
          "inspect"
        ],
        "lifecycle_planning": {
          "bounded_action": "bootstrap",
          "eligible_statuses": [
            "NOT_DEPLOYED"
          ]
        }
      }
    },
    {
      "service_id": "homepage-api",
      "logical_id": "homepage-api",
      "runtime_health": false,
      "role": "presentation-api",
      "owner": "aicontrolcenter",
      "required": true,
      "production_status": "PRODUCTION",
      "runtime": "embedded-aicontrolcenter-api",
      "supervisor": "system-launchdaemon",
      "lifecycle": "embedded",
      "listen_host": "127.0.0.1",
      "port": 58081,
      "health_endpoint": "/homepage/status",
      "ubuntu_dependency": false,
      "state_policy": "read-only-projection"
    },
    {
      "service_id": "ubuntu-main",
      "logical_id": "ubuntu-main",
      "runtime_health": false,
      "role": "optional-infrastructure-worker",
      "owner": "ubuntu-worker",
      "required": false,
      "production_status": "OPTIONAL_UNAVAILABLE_ALLOWED",
      "runtime": "external-host",
      "supervisor": "external",
      "lifecycle": "external",
      "ubuntu_dependency": true,
      "state_policy": "stateless-worker",
      "powered_off_allowed": true
    },
    {
      "service_id": "ollama",
      "logical_id": "ollama",
      "runtime_health": false,
      "role": "local-ai-runtime",
      "owner": "aicontrolcenter-adapter",
      "required": false,
      "production_status": "NOT_RUNNING",
      "runtime": "native-macos",
      "supervisor": "UNASSIGNED",
      "lifecycle": "unmanaged",
      "listen_host": "127.0.0.1",
      "port": 11434,
      "health_endpoint": "/api/tags",
      "ubuntu_dependency": false,
      "state_policy": "replaceable-provider"
    },
    {
      "service_id": "n8n",
      "logical_id": "n8n",
      "runtime_health": false,
      "role": "workflow-executor",
      "owner": "aicontrolcenter-adapter",
      "required": false,
      "production_status": "NOT_DEPLOYED",
      "runtime": "UNASSIGNED",
      "supervisor": "UNASSIGNED",
      "lifecycle": "not_deployed",
      "listen_host": "127.0.0.1",
      "port": 5678,
      "health_endpoint": "/healthz",
      "ubuntu_dependency": false,
      "state_policy": "execution-only"
    },
    {
      "service_id": "openclaw",
      "logical_id": "openclaw",
      "runtime_health": false,
      "role": "personal-assistant-interface",
      "owner": "aicontrolcenter-adapter",
      "required": false,
      "production_status": "NOT_DEPLOYED",
      "runtime": "UNASSIGNED",
      "supervisor": "UNASSIGNED",
      "lifecycle": "not_deployed",
      "ubuntu_dependency": false,
      "state_policy": "interface-only"
    },
    {
      "service_id": "telegram",
      "logical_id": "telegram",
      "runtime_health": true,
      "role": "optional-control-plane-capability",
      "owner": "aicontrolcenter",
      "required": false,
      "production_status": "NOT_DEPLOYED",
      "runtime": "UNASSIGNED",
      "supervisor": "UNASSIGNED",
      "lifecycle": "not_deployed",
      "ubuntu_dependency": false,
      "state_policy": "optional-capability"
    },
    {
      "service_id": "application-scheduler",
      "logical_id": "scheduler",
      "runtime_health": true,
      "role": "required-control-plane-capability",
      "owner": "aicontrolcenter",
      "required": true,
      "production_status": "PRODUCTION",
      "runtime": "python-immutable-venv",
      "supervisor": "system-launchdaemon",
      "lifecycle": "launchd",
      "launchd_label": "com.aicontrolcenter.application-scheduler",
      "ubuntu_dependency": false,
      "state_policy": "heartbeat-observed",
      "service_platform": {
        "immutable_runtime": {
          "runtime_root": "/Users/kyouhan/Library/Application Support/AIControlCenter/runtime"
        },
        "application_entrypoint": "core.scheduler.daemon",
        "log_parent": {
          "path": "/var/log/aicontrolcenter",
          "type": "directory",
          "mode": 493,
          "owner": "root",
          "group": "wheel"
        },
        "logs": [
          {
            "path": "/var/log/aicontrolcenter/application-scheduler.stdout.log",
            "type": "file",
            "mode": 416,
            "owner": "kyouhan",
            "group": "staff"
          },
          {
            "path": "/var/log/aicontrolcenter/application-scheduler.stderr.log",
            "type": "file",
            "mode": 416,
            "owner": "kyouhan",
            "group": "staff"
          }
        ],
        "health_observation": "heartbeat",
        "lifecycle_capabilities": [
          "inspect"
        ],
        "lifecycle_planning": {
          "bounded_action": "bootstrap",
          "eligible_statuses": [
            "NOT_DEPLOYED"
          ]
        }
      }
    }
  ]
}

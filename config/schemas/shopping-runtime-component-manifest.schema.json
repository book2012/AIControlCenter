  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "version",
        "artifact_digest_or_immutable_identity",
        "identity_status",
        "role",
        "effect_class",
        "outbound_network_allowed",
        "application_state_write_allowed",
        "handles_authorization",
        "participates_in_observation"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "artifact_digest_or_immutable_identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "identity_status": {
          "enum": [
            "UNRESOLVED",
            "REVIEWED_EXACT"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "effect_class": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "outbound_network_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "application_state_write_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "handles_authorization": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "participates_in_observation": {
          "const": false
        }
      }
    }
  }

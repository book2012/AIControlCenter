{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicontrolcenter.local/schemas/shopping-secret-backend.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_id", "owner", "backend_kind", "production_status", "value_free", "materialization_implemented", "encrypted_payload", "identity_custody", "control_plane_recipient", "offline_recovery_inbox", "offline_recovery_recipient", "recipient_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "definition_id": {"const": "shopping-secret-backend"},
    "owner": {"const": "MAC_MINI_M4_AICONTROLCENTER_CONTROL_PLANE"},
    "backend_kind": {"const": "sops-age"},
    "production_status": {"const": "NOT_DEPLOYED"},
    "value_free": {"const": true},
    "materialization_implemented": {"const": false},
    "encrypted_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "required_owner", "maximum_mode"],
      "properties": {
        "path": {"type": "string", "pattern": "^deploy/shopping/secrets/[a-z0-9.-]+\\.enc\\.yaml$"},
        "required_owner": {"const": "control-plane-user"},
        "maximum_mode": {"const": "0600"}
      }
    },
    "identity_custody": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "base", "relative_path", "required_owner", "maximum_mode", "external_to_repository", "contents_inspected"],
      "properties": {
        "platform": {"const": "macos"},
        "base": {"const": "control-plane-home"},
        "relative_path": {"const": ".config/sops/age/keys.txt"},
        "required_owner": {"const": "control-plane-user"},
        "maximum_mode": {"const": "0600"},
        "external_to_repository": {"const": true},
        "contents_inspected": {"const": false}
      }
    },
    "control_plane_recipient": {"$ref": "#/$defs/controlPlaneRecipient"},
    "offline_recovery_inbox": {
      "allOf": [
        {"$ref": "#/$defs/offlineRecoveryInbox"}
      ]
    },
    "offline_recovery_recipient": {"$ref": "#/$defs/offlineRecoveryRecipient"},
    "recipient_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_recipients", "roles", "recipient_material_stored"],
      "properties": {
        "minimum_recipients": {"type": "integer", "minimum": 2, "const": 2},
        "roles": {"type": "array", "prefixItems": [{"const": "control-plane"}, {"const": "offline-recovery"}], "items": false},
        "recipient_material_stored": {"const": false}
      }
    }
  },
  "$defs": {
    "controlPlaneRecipient": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "relative_path", "required_owner", "maximum_mode"],
      "properties": {"base": {"const": "control-plane-home"}, "relative_path": {"const": ".config/aicontrolcenter/shopping-secrets/recipients/control-plane.txt"}, "required_owner": {"const": "control-plane-user"}, "maximum_mode": {"const": "0600"}}
    },
    "offlineRecoveryInbox": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "relative_path", "required_owner", "maximum_mode", "private_identity_custody"],
      "properties": {"base": {"const": "control-plane-home"}, "relative_path": {"const": ".config/aicontrolcenter/shopping-secrets/inbox/offline-recovery.txt"}, "required_owner": {"const": "control-plane-user"}, "maximum_mode": {"const": "0600"}, "private_identity_custody": {"const": "external"}}
    },
    "offlineRecoveryRecipient": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "relative_path", "required_owner", "maximum_mode"],
      "properties": {"base": {"const": "control-plane-home"}, "relative_path": {"const": ".config/aicontrolcenter/shopping-secrets/recipients/offline-recovery.txt"}, "required_owner": {"const": "control-plane-user"}, "maximum_mode": {"const": "0600"}}
    }
  }
}

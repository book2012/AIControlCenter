{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicontrolcenter.local/schemas/shopping-secret-provisioning.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_id", "backend_definition_id", "inspection_mode", "governance_compatibility", "production_status", "materialization_implemented", "value_free", "offline_recovery_intake_policy", "actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "definition_id": {"const": "shopping-secret-provisioning"},
    "backend_definition_id": {"const": "shopping-secret-backend"},
    "inspection_mode": {"const": "READ_ONLY"},
    "governance_compatibility": {"const": "SEC-02_CONTROLLED_EXECUTION"},
    "production_status": {"const": "NOT_DEPLOYED"},
    "materialization_implemented": {"const": false},
    "value_free": {"const": true},
    "offline_recovery_intake_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "relative_path", "required_owner", "maximum_mode", "external_to_repository", "no_clobber", "public_recipient_only"],
      "properties": {
        "base": {"const": "control-plane-home"},
        "relative_path": {"const": ".config/aicontrolcenter/shopping-secrets/inbox/offline-recovery.txt"},
        "required_owner": {"const": "control-plane-user"},
        "maximum_mode": {"const": "0600"},
        "external_to_repository": {"const": true},
        "no_clobber": {"const": true},
        "public_recipient_only": {"const": true}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "planner_rule", "missing_reason_code"],
          "properties": {
            "action_id": {"const": "SHOPPING_SECRET_TOOL:SOPS_INSTALL_ENSURE"},
            "planner_rule": {"const": "SOPS_PRESENT"},
            "missing_reason_code": {"const": "SOPS_TOOL_MISSING"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "planner_rule", "missing_reason_code"],
          "properties": {
            "action_id": {"const": "SHOPPING_SECRET_TOOL:AGE_INSTALL_ENSURE"},
            "planner_rule": {"const": "AGE_TOOLING_PRESENT"},
            "missing_reason_code": {"const": "AGE_TOOLING_MISSING"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "planner_rule", "missing_reason_code"],
          "properties": {
            "action_id": {"const": "SHOPPING_SECRET_IDENTITY:CONTROL_PLANE_CREATE"},
            "planner_rule": {"const": "CONTROL_PLANE_IDENTITY_PRESENT"},
            "missing_reason_code": {"const": "CONTROL_PLANE_IDENTITY_MISSING"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "planner_rule", "missing_reason_code"],
          "properties": {
            "action_id": {"const": "SHOPPING_SECRET_RECIPIENT:CONTROL_PLANE_REGISTER_VALIDATE"},
            "planner_rule": {"const": "CONTROL_PLANE_RECIPIENT_VALID"},
            "missing_reason_code": {"const": "CONTROL_PLANE_RECIPIENT_METADATA_MISSING_OR_INVALID"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "planner_rule", "missing_reason_code"],
          "properties": {
            "action_id": {"const": "SHOPPING_SECRET_RECIPIENT:OFFLINE_RECOVERY_REGISTER_VALIDATE"},
            "planner_rule": {"const": "OFFLINE_RECOVERY_RECIPIENT_VALID"},
            "missing_reason_code": {"const": "OFFLINE_RECOVERY_RECIPIENT_METADATA_MISSING_OR_INVALID"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "planner_rule", "missing_reason_code"],
          "properties": {
            "action_id": {"const": "SHOPPING_SECRET_RECIPIENT:OFFLINE_RECOVERY_INTAKE"},
            "planner_rule": {"const": "OFFLINE_RECOVERY_INBOX_READY"},
            "missing_reason_code": {"const": "OFFLINE_RECOVERY_PUBLIC_RECIPIENT_INTAKE_REQUIRED"}
          }
        }
      ],
      "items": false
    }
  }
}

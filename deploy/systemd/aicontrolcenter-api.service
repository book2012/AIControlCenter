[Unit]
Description=AIControlCenter API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=han
Group=han
WorkingDirectory=/opt/AIControlCenter
EnvironmentFile=/opt/AIControlCenter/.env
ExecStart=/opt/AIControlCenter/.venv/bin/python -m scripts.api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

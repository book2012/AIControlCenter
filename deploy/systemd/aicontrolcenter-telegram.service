[Unit]
Description=AIControlCenter Telegram Bot
After=network-online.target aicontrolcenter-api.service
Wants=network-online.target

[Service]
Type=simple
User=han
Group=han
WorkingDirectory=/opt/AIControlCenter
EnvironmentFile=/opt/AIControlCenter/.env
ExecStart=/opt/AIControlCenter/.venv/bin/python -m scripts.telegram
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

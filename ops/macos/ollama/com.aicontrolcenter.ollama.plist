<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aicontrolcenter.ollama</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ollama</string>
    <string>serve</string>
  </array>
  <key>UserName</key>
  <string>kyouhan</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key>
    <string>127.0.0.1:11434</string>
    <key>OLLAMA_MODELS</key>
    <string>/Users/kyouhan/Library/Application Support/Ollama/models</string>
    <key>OLLAMA_KEEP_ALIVE</key>
    <string>5m</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/kyouhan/Library/Logs/AIControlCenter/ollama.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kyouhan/Library/Logs/AIControlCenter/ollama.stderr.log</string>
</dict>
</plist>

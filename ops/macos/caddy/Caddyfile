bokstory.duckdns.org {
    log {
        output discard
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Private WordPress REST namespaces remain denied even when query-style
    # routing is used. The raw-query guard is intentionally broader than the
    # private namespace because no WordPress REST namespace is public.
    @shopping_namespace path /wp-json/aicontrolcenter/v1/shopping /wp-json/aicontrolcenter/v1/shopping/*
    @shopping_rest_route query rest_route=/aicontrolcenter/v1/shopping rest_route=/aicontrolcenter/v1/shopping/*
    # Detect rest_route key aliases, case variants, nested percent encoding,
    # repeated parameters, and &/; separator variants before any proxy.
    @shopping_rest_route_ambiguous vars_regexp {http.request.uri.query} `(?i)(^|[&;]|%(?:25)*(?:26|3b))(?:r|%(?:25)*(?:52|72))(?:e|%(?:25)*(?:45|65))(?:s|%(?:25)*(?:53|73))(?:t|%(?:25)*(?:54|74))(?:_|[.+]|%(?:25)*(?:2b|2e|5f|20))(?:r|%(?:25)*(?:52|72))(?:o|%(?:25)*(?:4f|6f))(?:u|%(?:25)*(?:55|75))(?:t|%(?:25)*(?:54|74))(?:e|%(?:25)*(?:45|65))(?:=|%(?:25)*(?:3d)|[&;]|%(?:25)*(?:26|3b)|$)`
    @public_shopping_read {
        method GET
        path /shopping/categories /shopping/search /shopping/featured-products /shopping/products /shopping/products/*
    }
    @public_shopping_namespace path /shopping /shopping/*
    @management_namespace path /admin /admin/* /management /management/* /api /api/* /deployment /deployment/* /runtime /runtime/* /governance /governance/* /providers /providers/* /tasks /tasks/* /woocommerce /woocommerce/* /cart /cart/* /checkout /checkout/* /my-account /my-account/* /order-pay /order-pay/* /add-to-cart /add-to-cart/* /wc-api /wc-api/*
    @wordpress_namespace path /wp-admin /wp-admin/* /wp-login.php /xmlrpc.php /wp-cron.php /wp-json /wp-json/*
    @legacy_storefront path /homepage/storefront
    route {
        respond @shopping_namespace "Forbidden" 403
        respond @shopping_rest_route "Forbidden" 403
        respond @shopping_rest_route_ambiguous "Forbidden" 403
        redir @legacy_storefront / 301
        respond @management_namespace "Not Found" 404
        respond @wordpress_namespace "Not Found" 404
        handle @public_shopping_read {
            reverse_proxy 127.0.0.1:58081
        }
        respond @public_shopping_namespace "Not Found" 404
        respond /__aicontrolcenter_ingress_health "ok" 200
        respond /healthz "ok" 200
        reverse_proxy 127.0.0.1:58082
    }
}


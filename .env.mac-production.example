AICC_ENV=mac-production

AICC_HOST=127.0.0.1
AICC_PORT=8000

DATACENTER_HOST=192.168.1.7
DATACENTER_SSH_USER=han
DATACENTER_SSH_PORT=22

DATACENTER_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
DATACENTER_WOL_BROADCAST=192.168.1.255

AICC_PROJECT_ROOT=/opt/AIControlCenter
AICC_PYTHON=/opt/AIControlCenter/.venv/bin/python
AICC_LOG_DIR=/opt/AIControlCenter/var/log

# AI Shopping Platform
SHOPPING_ENABLED=true
SHOPPING_ENVIRONMENT=production
SHOPPING_RUNTIME=macos
SHOPPING_DEPLOYMENT_TARGET=mac-mini-m4
SHOPPING_WRITE_MODE=read_only
SHOPPING_APPROVAL_REQUIRED=true
SHOPPING_AUTOMATION_ENABLED=false
SHOPPING_AI_ENABLED=false
